# Copy to .env and configure an approved non-production target.
# .env is ignored by Git and excluded from the container build context.
# Inject credentials through your runtime secret mechanism where possible.
# Atlas URI syntax (placeholder only):
#   mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true
# Local Compose MongoDB: mongodb://mongo:27017
# URL-encode reserved characters in URI usernames and passwords.
MONGODB_URI=
SEEDER_CONFIG_FILE=config.test.yaml
# Optional image tag for the locally built image.
SEEDER_IMAGE=mongodb-atlas-data-seeder:local
